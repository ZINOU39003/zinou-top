# ZINOU TOP - release signing configuration TEMPLATE (contains no secrets).
#
# 1. Copy this file to "keystore.properties" in the same folder (repository root).
#    keystore.properties is git-ignored and must never be committed.
# 2. Fill in the values. Use an ABSOLUTE path with forward slashes, outside the repository.
#    Windows example: storeFile=C:/Users/YOUR_WINDOWS_USER/ZinouTopKeys/zinou-top-release.jks
# 3. The keystore is PKCS12: storePassword and keyPassword must be the SAME value.
# 4. Do not leave trailing spaces after the values.
#
# Debug builds do not need this file. Release builds (assembleZinouRelease) do.

storeFile=
storePassword=
keyAlias=zinou-top
keyPassword=
